{
  "name": "jarvis-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Marketing and install site for JARVIS, the local-first personal AI operating system.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:install": "node scripts/check-install.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "license": "Apache-2.0"
}
